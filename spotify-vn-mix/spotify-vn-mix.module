#!name=Spotify VN Mix v3.2 (Nut Phoi AutoLens 170 + 215B f18 + ToCam Badge)
#!desc=Hop nhat v3.2 (chuan cu phap Shadowrocket khong [Rule] / khong binary-body-mode / khong timeout, mo Nut Phoi L2: AutoLens kind=170 'mix' 66B + MixabilityTrait kind=235 59B + full 215B f18 + 4-lens f22 + f3.f12 can-view-transition tren ca /diff & /playlist + chan podcast-chapters/diff) + Jam + badge 23B ToCam #1ED760 + the goi 116B.
#!category=Spotify
#!author=c4 / Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/spotify-vn-mix.module

[MITM]
hostname = %APPEND% *.spotify.com

[Script]
SpotifyMix_Clean = type=http-request,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-request.js?v=32
SpotifyMix_Level = type=http-request,pattern=^https://.*spotify\.com/storage-resolve/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-audio-level.js?v=32
SpotifyMix_Patch = type=http-response,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-premium.js?v=32,requires-body=true,max-size=524288
SpotifyMix_AudioErr = type=http-response,pattern=^https://.*spotify\.com/storage-resolve/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-audio-err.js?v=32
SpotifyMix_Drip = type=http-request,pattern=^https://.*spotify\.com/(gabo-receiver|reachability|color-lyrics|collection|apresolve|net-fortune),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/drip.js?v=32
