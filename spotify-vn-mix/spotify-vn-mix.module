#!name=Spotify VN Mix v3.0 (Nut Phoi Jam + Playlist Mix + ToCam Badge)
#!desc=Hop nhat v3.0 (mo lop Jam / Phoi: social-connect, sessions/current, connect-group, device-proxy, clientrestrictions, đục sâu 2 lớp protobuf + 13 cờ sociallistening + phanh tự lùi chống nhảy bài) + v2.8 Playlist Mix (TransitionRowInteractionVariant=EDIT, mixing-tools) + v2.6.2 (badge 23B ToCam #1ED760, thẻ gói 116B đầy đủ).
#!category=Spotify
#!author=Script goc: xzavier-amico / lyc-000001 · fix & merge: Zaka + c4
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/spotify-vn-mix.module

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

URL-REGEX,^https?://[^/]*spotify\.com/(?:ads/v3|ad-logic|sponsoredplaylist|premium-marketing),REJECT

AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,scdn.co),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spotifycdn.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spotifycdn.net),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist) header-del if-none-match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist) header-del If-None-Match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist) header-del if-modified-since

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com, *.spotify.com, spotify.com, login5.spotify.com

[Script]
# 1) REQUEST: xoa If-None-Match + ep identity
SpotifyMix Request = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|configuration|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|capabilities|login5|v3\/login|v4\/login|subscription|attributes|catalogue|premium|premiumdestinationbadge|BadgeService|checkout|payment|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|social-connect|connect-group|device-proxy|ondemand-selector|offline|capping-api|identity|audio-attributes|media-quality|quality|settings|referrals|playlist-v2|playlist|casita),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-request.js,timeout=15

# 2) REQUEST: ep cap am thanh + phanh tu lui chong nhay bai (v3.0)
SpotifyMix AudioLevel = type=http-request,pattern=^https:\/\/(?:[\w.-]+\.)*spotify\.com(?::443)?\/storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)\/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-audio-level.js,timeout=10

# 3) RESPONSE: patch protobuf / gRPC / JSON (mo Nut Phoi SelectedListContent f3.f12 + Jam + badge ToCam 23B + the goi 116B)
SpotifyMix Response = type=http-response,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|configuration|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|capabilities|login5|v3\/login|v4\/login|subscription|attributes|catalogue|premium|premiumdestinationbadge|BadgeService|checkout|payment|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|social-connect|connect-group|device-proxy|ondemand-selector|offline|capping-api|identity|audio-attributes|media-quality|quality|settings|referrals|playlist-v2|playlist|casita),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-premium.js,requires-body=true,binary-body-mode=true,max-size=4194304,timeout=30

# 4) RESPONSE: dem loi file nhac (khong requires-body, khong buffer file nhac) -> nuoi phanh tu lui
SpotifyMix AudioErr = type=http-response,pattern=^https:\/\/[^/]+\/storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)\/\d+\/[a-zA-Z0-9]+,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/spotify-audio-err.js,timeout=10

# 5) REQUEST: bom hex nho vao query zcap= -> nam trong log .db
SpotifyMix Drip = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:gabo-receiver-service|reachability\/check|color-lyrics|gander\/v2|collection\/v2|net-fortune\/v2\/fortune|apresolve),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-mix/scripts/drip.js,timeout=15
