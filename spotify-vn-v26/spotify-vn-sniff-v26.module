#!name=Spotify VN Sniff v2.6 (Chuyen bat Nut Phoi Jam + Playlist Mix + Hex)
#!desc=Module bat goi tin SACH v2.6 chuyen san NUT PHOI (Jam / social-connect / connect-group / connect-state / device-proxy / supported-commands / clientrestrictions + Playlist Mix / transition / curation / playlist-v2 / lens / pathfinder). Tu dong tat banner PAM/Quality cu de khong ngap man hinh, chi hien banner [NUT PHOI] & [PHOI-CFG] kem cay protobuf (f1=.. f2={..}) + hex day du va bom zcap= vao log .db.
#!category=Spotify
#!author=c4 / ToCam
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/spotify-vn-sniff-v26.module

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,scdn.co),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|clientrestrictions|spotify\.clientrestrictions|jam_status|social-connect|connect-group|connect-state|device-proxy|playlist|playlist-v2|lens|mix|mixing|automix|transition|curation|casita|blend|pathfinder|extended-metadata|attributes) header-del if-none-match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|clientrestrictions|spotify\.clientrestrictions|jam_status|social-connect|connect-group|connect-state|device-proxy|playlist|playlist-v2|lens|mix|mixing|automix|transition|curation|casita|blend|pathfinder|extended-metadata|attributes) header-del If-None-Match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|clientrestrictions|spotify\.clientrestrictions|jam_status|social-connect|connect-group|connect-state|device-proxy|playlist|playlist-v2|lens|mix|mixing|automix|transition|curation|casita|blend|pathfinder|extended-metadata|attributes) header-del if-modified-since

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com, *.spotify.com, spotify.com

[Script]
SpotVN26_Clean_Req = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/.*(bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|clientrestrictions|GetRestrictedIntegrations|jam_status|jam|social-connect|connect-group|connect-state|device-proxy|supported-commands|sessions/current|refresh-group-data|playlist|playlist-v2|mix|mixing|automix|transition|curation|lens|casita|blend|pathfinder|extended-metadata|attributes|audio-attributes|audio-features),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/spotify-request.js,timeout=15

SpotVN26_Sniff_Req = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/.*(jam_status|social-connect|connect-group|connect-state|device-proxy|supported-commands|sessions/current|refresh-group-data|clientrestrictions|GetRestrictedIntegrations|playlist-v2|mix|mixing|automix|transition|curation|lens|casita|blend),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/sniff-clean.js,timeout=10

SpotVN26_Sniff_Res = type=http-response,pattern=^https://[^/]*spotify\.com(:443)?/.*(jam_status|jam|social-connect|connect-group|connect-state|device-proxy|supported-commands|sessions/current|refresh-group-data|clientrestrictions|GetRestrictedIntegrations|playlist|playlist-v2|mix|mixing|automix|transition|curation|smart-reorder|lens|casita|blend|pathfinder|extended-metadata|audio-attributes|audio-features|player|context-player|play-session|party|bootstrap|user-customization-service|ucs|resolve|nebula|remote-config-resolver|configuration|attributes|pam-view-service|device-capabilities|playback-settings),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/sniff-clean.js,requires-body=true,binary-body-mode=true,max-size=524288,timeout=20

SpotVN26_Drip = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/(?:gabo-receiver-service|reachability/check|color-lyrics|gander/v2|collection/v2|net-fortune/v2/fortune|apresolve),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/drip.js,timeout=15
