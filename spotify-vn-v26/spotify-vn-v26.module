#!name=Spotify VN Premium v2.6.2 (ToCam Badge + PlanRow/Overview + VeryHigh)
#!desc=Ban v2.6.2 doc lap (KHONG dung den ban v2.5 chinh). (1) Giu nguyen badge xanh ToCam (23B: ToCam + field2=2 + #1ED760, cuu ca body rong 0B). (2) Sua GetPremiumPlanRow (68B->116B: #B3B3B3 -> #1ED760, Spotify Free -> Premium Individual + Individual), GetPlanOverview (944B) & GetShowValuePlanOverview (1837B). (3) Mo khoa v1/capabilities (574B->583B) + tat toan bo ios-reinventfree-* trong v3/configuration (108KB).
#!category=Spotify
#!author=Script goc: xzavier-amico / lyc-000001 · v2.6.2 fix: c4 / Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png

[Rule]
# --- 1. Chan domain quang cao (giu nguyen 100% nhu v2.5 dang chay ngon) ---
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

# --- 2. Chan endpoint quang cao nam CHUNG host voi API (KHONG chan net-fortune) ---
URL-REGEX,^https?://[^/]*spotify\.com/(?:ads/v3|ad-logic|sponsoredplaylist|premium-marketing),REJECT

# --- 3. Chan QUIC/UDP cua Spotify de bat buoc di qua MITM HTTPS ---
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT

[MITM]
hostname = %APPEND% *.spotify.com, spotify.com

[Script]
# --- 4. Buoc REQUEST: ep cap am thanh trong URL (0/1 -> 2 cho ca interactive va interactive_prefetch) ---
SpotifyVN26 AudioLevel = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)\/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/spotify-audio-level.js,timeout=10

# --- 5. Buoc REQUEST: xoa If-None-Match + ep identity cho ca REST va gRPC (chong 304 va frame nen 0x01) ---
SpotifyVN26 Request = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|configuration|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|capabilities|login5|v3\/login|v4\/login|subscription|attributes|catalogue|premium|premiumdestinationbadge|BadgeService|checkout|payment|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|connect-group|connect-state|ondemand-selector|offline|capping-api|identity|audio-attributes|media-quality|quality|settings|referrals),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/spotify-request.js,timeout=15

# --- 6. Buoc RESPONSE: sua payload protobuf / gRPC / JSON (max-size=4194304 de du chua v3/configuration 108KB+) ---
SpotifyVN26 Response = type=http-response,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|configuration|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|capabilities|login5|v3\/login|v4\/login|subscription|attributes|catalogue|premium|premiumdestinationbadge|BadgeService|checkout|payment|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|connect-group|connect-state|ondemand-selector|offline|capping-api|identity|audio-attributes|media-quality|quality|settings|referrals|storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/spotify-premium.js,requires-body=true,binary-body-mode=true,max-size=4194304,timeout=30

# --- 7. Buoc REQUEST: bom hex cua cac goi nho da gom vao query zcap= trong log .db ---
SpotifyVN26 Drip = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:gabo-receiver-service|reachability\/check|color-lyrics|gander\/v2|collection\/v2|net-fortune\/v2\/fortune|apresolve),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-v26/scripts/drip.js,timeout=15
