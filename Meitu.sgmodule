#!name=Meitu VIP (rewrite v2)
#!desc=Unlock VIP Meitu XiuXiu & Wink - chỉ MITM host API, KHÔNG đụng CDN ảnh
#!system=ios
#!====================================================
# Cài: Surge/Loon -> module này. Shadowrocket -> dùng file Meitu.conf
# script-path sửa thành link raw của bạn (worker/gist) hoặc tên file local tuỳ app.

[MITM]
hostname = %APPEND%, api-sub.meitu.com, api.meitu.com, *.xiuxiu.meitu.com
# Cố tình KHÔNG đưa meitudata.com / res / file / img vào đây:
# đó là CDN ảnh + template, MITM vào là app báo "lỗi kết nối mạng" khi sửa ảnh.

[Script]
Meitu VIP = type=http-response,pattern=^https?:\/\/[^\/]*meitu\.com\/,requires-body=1,max-size=524288,timeout=10,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/MeiTuVIP.js

# Bản dò endpoint (bật khi VIP không ăn): comment dòng trên, bỏ comment dòng dưới
# Meitu PROBE = type=http-response,pattern=^https?:\/\/[^\/]*meitu\.com\/,requires-body=1,max-size=524288,timeout=10,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/MeiTuProbe.js
