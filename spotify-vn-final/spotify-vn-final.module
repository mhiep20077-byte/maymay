#!name=Spotify VN Final (Full Premium + Nut Phoi + ToCam Badge · Im Lang)
#!desc=Ban hoan chinh doc lap trong folder spotify-vn-final, TAT HOAN TOAN thong bao Shadowrocket & tat drip log: (1) Mo khoa Premium, chan quang cao, nghe theo yeu cau, tua/chuyen bai khong gioi han. (2) Vien badge [ToCam] 23B xanh la #1ED760 + the goi Premium Individual 116B + nhan Rat cao (VERY_HIGH) + phanh tu lui chong nhay bai. (3) Mo lop Nut Phoi (Jam + Playlist Mix: AutoLens kind=170 'mix' 66B, MixabilityTrait kind=235 59B, SelectedListContent 215B f18 + 4-lens f22 + f23=1).
#!category=Spotify
#!author=c4 / Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-final/spotify-vn-final.module

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

URL-REGEX,^https?://[^/]*spotify\.com/(?:ads/v3|ad-logic|sponsoredplaylist|premium-marketing),REJECT

AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,scdn.co),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spotifycdn.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,spotifycdn.net),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist|extended-metadata) header-del if-none-match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist|extended-metadata) header-del If-None-Match
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[\w-]+-spclient\.spotify\.com)(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|pam-view-service|device-capabilities|playback-settings|clientrestrictions|spotify\.clientrestrictions|product-state|user-profile|attributes|net-fortune|jam_status|social-connect|connect-group|device-proxy|configuration|playlist-v2|playlist|extended-metadata) header-del if-modified-since

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *.spotify.com, spotify.com, login5.spotify.com

[Script]
# 1) REQUEST: xoa If-None-Match + ep identity (chong 304 va chong gzip)
SpotifyFinal Request = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/.*(bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|product-state|product_state|user-profile|user_profile|device-capabilities|capabilities|login5|v3/login|v4/login|subscription|attributes|catalogue|premiumdestinationbadge|BadgeService|pam-view-service|pam-account|playback-settings|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|social-connect|connect-group|device-proxy|ondemand-selector|capping-api|identity|audio-attributes|media-quality|playlist-v2|playlist|signals|diff|extended-metadata|casita),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-final/scripts/spotify-request.js,timeout=15

# 2) REQUEST: ep cap am thanh + phanh tu lui chong nhay bai
SpotifyFinal AudioLevel = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/storage-resolve/v2/files/audio/(interactive|interactive_prefetch)/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-final/scripts/spotify-audio-level.js,timeout=10

# 3) RESPONSE: patch protobuf / gRPC / JSON (im lang 100%, khong hien banner thong bao)
SpotifyFinal Response = type=http-response,pattern=^https://[^/]*spotify\.com(:443)?/.*(bootstrap|user-customization-service|ucs|nebula|remote-config-resolver|configuration|product-state|product_state|user-profile|user_profile|device-capabilities|capabilities|login5|v3/login|v4/login|subscription|attributes|catalogue|premiumdestinationbadge|BadgeService|pam-view-service|pam-account|playback-settings|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|social-connect|connect-group|device-proxy|ondemand-selector|capping-api|identity|audio-attributes|media-quality|playlist-v2|playlist|signals|diff|extended-metadata|casita),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-final/scripts/spotify-premium.js,requires-body=true,binary-body-mode=true,max-size=4194304,timeout=30

# 4) RESPONSE: dem loi file nhac -> nuoi phanh tu lui
SpotifyFinal AudioErr = type=http-response,pattern=^https://[^/]+/storage-resolve/v2/files/audio/(interactive|interactive_prefetch)/\d+/[a-zA-Z0-9]+,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-final/scripts/spotify-audio-err.js,timeout=10
