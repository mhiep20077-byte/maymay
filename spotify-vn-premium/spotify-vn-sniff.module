#!name=Spotify VN Sniff (Bat goi sach)
#!desc=Module bat goi tin SACH chuan Shadowrocket. Chi bat dung 3 nhom: Chat luong rat cao, Ho so Premium va Quan ly goi (khong chan dealer/apresolve). Hien thong bao banner tren Shadowrocket va ghi log [spot-sniff].
#!category=Spotify
#!author=ToCam
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium

[MITM]
hostname = %APPEND% *.spotify.com

[Script]
SpotVN_Sniff_Req = type=http-request,pattern=^https://[^/]*spotify\.com(:443)?/.*(storage-resolve|net-fortune),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/sniff-clean.js
SpotVN_Sniff_Res = type=http-response,pattern=^https://[^/]*spotify\.com(:443)?/.*(storage-resolve|net-fortune|device-capabilities|playback|audio|quality|bitrate|ondemand|bootstrap|ucs|resolve|nebula|product|profile|attributes|subscription|catalogue|premium|identity|login5|pam|plan|tier|entitlement|capability|capabilities|restriction|badge|account|checkout|payment|ViewService|Settings|Quality|Plan|Profile|Premium),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/sniff-clean.js,requires-body=true,max-size=524288
