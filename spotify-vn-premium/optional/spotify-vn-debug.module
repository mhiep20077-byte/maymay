[MITM]
hostname = %APPEND% *.spotify.com

[Script]
SpotVN_Debug = type=http-response,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/debug.js,requires-body=true,max-size=262144
