#!name=Spotify VN CAPTURE (bắt gói + thông báo)
#!desc=Module chẩn đoán có THÔNG BÁO: mỗi response Spotify khớp pattern sẽ nổi banner trên máy (như thông báo của Script). Nội dung banner in endpoint + chuỗi quality/bitrate/premium/restrict bên trong payload, để biết app hỏi gì mà trang "Chất lượng nội dung" vẫn khoá. KHÔNG sửa gì, chỉ đọc. Bật module này THAY module chính, mở trang Chất lượng nội dung + trang Tài khoản 1 lần, rồi gửi lại các banner/dòng [spot-vn-dbg].
#!category=Spotify
#!author=Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT

[Script]
SpotifyVN Capture = type=http-response,pattern=^https:\/\/[a-z0-9.-]*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|device-capabilities|identity|pam-view-service|playback-settings|clientrestrictions|user-profile|profile|account|product-state|product_state|subscription|attributes|catalogue|premium|checkout|payment|settings|capabilities|v3\/login|me(?:\/|\?|$)),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/capture.js,requires-body=true,binary-body-mode=true,max-size=1048576,timeout=20

[MITM]
hostname = %APPEND% *.spotify.com, spotify.com
