#!name=Spotify VN v2.6 (patch + bắt gói + thông báo)
#!desc=v2.6: TẤT CẢ TRONG MỘT MODULE. (1) Patch như cũ: bo ads, ép cấp âm thanh 2 trong URL storage-resolve, nâng chất lượng ở device-capabilities/playback-settings/net-fortune, badge ToCam. (2) MỚI: mỗi response Spotify nổi THÔNG BÁO trên máy in endpoint + cờ 96/160/320 + premium/free. (3) MỚI: gom body thật rồi bơm vào query của request kế tiếp (zcap=) nên nằm luôn trong file log .db mày xuất ra — tao đọc được nguyên payload, khỏi đoán. Cài xong mở app là thấy banner "CAPTURE ĐÃ CHẠY".
#!category=Spotify
#!author=Script goc: xzavier-amico / lyc-000001 · dong goi + fix: Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png

[Rule]
# --- Chan domain quang cao (khong anh huong phat nhac) ---
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

# --- Endpoint quang cao nam chung host voi API ---
# net-fortune KHONG bi chan: do la service chon file nhac kem bitrate.
URL-REGEX,^https?://[^/]*spotify\.com/(?:ads/v3|ad-logic|sponsoredplaylist|premium-marketing),REJECT

# --- Chan QUIC/UDP: HTTP/3 khong MITM duoc => script khong chay ---
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT

[MITM]
hostname = %APPEND% *.spotify.com, spotify.com

[Script]
# ===========================================================================
# 0) BẮT GÓI + THÔNG BÁO  (đặt trước để đọc body GỐC của server)
#    Banner: [spot-vn] net-fortune · HTTP 200 · 1.2KB · 320 ✔ q=VERY_HIGH
# ===========================================================================
SpotifyVN Capture = type=http-response,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?!storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)\/\d)(?:.|\n)*,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/capture.js,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=30

# ===========================================================================
# 0b) ĐẨY DỮ LIỆU ĐÃ GOM VÀO URL (để nó rơi vào log .db)
# ===========================================================================
SpotifyVN Drip = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:gabo-receiver-service|reachability\/check|color-lyrics|gander\/v2|collection\/v2|net-fortune\/v2\/fortune|apresolve),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/drip.js,timeout=15

# ===========================================================================
# 1) BUOC REQUEST: ep cap am thanh trong URL (0/1 -> 2), ca interactive va
#    interactive_prefetch.  Tat: {"audio_level":"keep"}
# ===========================================================================
SpotifyVN AudioLevel = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/storage-resolve\/v2\/files\/audio\/(?:interactive|interactive_prefetch)\/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-audio-level.js,timeout=10

# 2) BUOC REQUEST: don header de response luon co body that (304 = mat patch)
SpotifyVN Request = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|login5|subscription|attributes|catalogue|premium|checkout|payment|v3\/login|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|connect-group),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-request.js,timeout=15

# 3) BUOC RESPONSE: sua payload (free -> premium, chat luong, badge ToCam)
SpotifyVN Response = type=http-response,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|login5|subscription|attributes|catalogue|premium|checkout|payment|v3\/login|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations|net-fortune|jam_status|connect-group|ondemand-selector),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-premium.js,requires-body=true,binary-body-mode=true,max-size=1048576,timeout=30
