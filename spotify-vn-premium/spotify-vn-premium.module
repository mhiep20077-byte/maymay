#!name=Spotify VN v3.0 PREMIUM
#!desc=LITE + bat goi co banner + gom du lieu ve log. Nang nhat. Chi cai khi MINI/LITE da chay OK.
#!category=Spotify
#!author=Zaka

[MITM]
hostname = %APPEND% *.spotify.com

[Script]
SpotVN_Clean = type=http-request,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-request.js
SpotVN_Level = type=http-request,pattern=^https://.*spotify\.com/storage-resolve/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-audio-level.js
SpotVN_Patch = type=http-response,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-premium.js,requires-body=true,max-size=524288
SpotVN_Capture = type=http-response,pattern=^https://.*spotify\.com/,script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/capture.js,requires-body=true,max-size=524288
SpotVN_Drip = type=http-request,pattern=^https://.*spotify\.com/(gabo-receiver|reachability|color-lyrics|collection|apresolve|net-fortune),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/drip.js
