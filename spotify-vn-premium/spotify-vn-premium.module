#!name=Spotify VN Premium v2.4
#!desc=Bỏ ads + mở Premium phía máy (on-demand, skip không giới hạn, bỏ ép shuffle). v2.4: nhãn viên badge "Premium" -> chữ ToCam, giữ NỀN XANH LÁ như bản gốc trong app (muốn cam thì đặt badge_color=#FFA500); nâng chất lượng 96/160 -> 320 và gạt cờ khoá ở MỌI endpoint Spotify (không chỉ playback-settings). Không mở được offline/320kbps thật vì license + file nhạc do server cấp theo tier. Muốn xem app gửi gì về máy chủ: cài thêm spotify-vn-capture.module, mỗi response hiện thông báo trên máy.
#!category=Spotify
#!author=Script gốc: xzavier-amico / lyc-000001 · đóng gói + fix host: Zaka
#!homepage=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png

[Rule]
# --- 1. Chặn domain quảng cáo (an toàn, không ảnh hưởng phát nhạc) ---
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

# --- 2. Chặn endpoint quảng cáo nằm CHUNG host với API ---
# Ads của Spotify 9.2.x đi qua chính shard spclient (ads/v3, ad-logic, net-fortune,
# sponsoredplaylist, premium-marketing) nên chặn theo domain là không ăn.
# REJECT theo URL: app nhận lỗi kết nối -> coi như "không có ad" và phát tiếp.
# Nếu thấy nhạc khựng lúc bắt đầu phát, xoá dòng ads/v3 và ad-logic là hết.
URL-REGEX,^https?://[^/]*spotify\.com/(?:ads/v3|ad-logic|net-fortune|sponsoredplaylist|premium-marketing),REJECT

# --- 3. Chặn QUIC/UDP của Spotify: HTTP/3 KHÔNG MITM được ---
# Không chặn thì app đi HTTP/3, script không bao giờ chạy => "cài rồi mà không thấy gì".
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT

[Script]
SpotifyVN Request = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|login5|subscription|attributes|catalogue|premium|checkout|payment|v3\/login|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-request.js,timeout=15
SpotifyVN Response = type=http-response,pattern=^https:\/\/(?:[a-z0-9-]+\.)*spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|nebula|remote-config-resolver|product-state|product_state|product\/|user-profile|user_profile|profile|account|device-capabilities|login5|subscription|attributes|catalogue|premium|checkout|payment|v3\/login|me(?:\/|\?|$)|pam-view-service|pam-account|playback-settings|spotify\.clientrestrictions|clientrestrictions|GetRestrictedIntegrations),script-path=https://raw.githubusercontent.com/mhiep20077-byte/maymay/main/spotify-vn-premium/scripts/spotify-premium.js,requires-body=true,binary-body-mode=true,max-size=1048576,timeout=30

[MITM]
hostname = %APPEND% *.spotify.com, spotify.com
